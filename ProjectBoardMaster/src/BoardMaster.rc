#include <windows.h>
#include <commctrl.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
// Menu

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Configuration...\tCtrl+O", IDM_FILE_LOAD
        MENUITEM "&Save Configuration\tCtrl+S",    IDM_FILE_SAVE
        MENUITEM "Save Configuration &As...",      IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                          IDM_FILE_EXIT
    END
    POPUP "&Board"
    BEGIN
        MENUITEM "&Connect All\tF5",   IDM_BOARD_CONNECT
        MENUITEM "&Disconnect All",    IDM_BOARD_DISCONNECT
        MENUITEM SEPARATOR
        MENUITEM "&Identify\tF9",      IDM_BOARD_IDENTIFY
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About BoardMaster...", IDM_HELP_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Main dialog

IDD_MAIN DIALOGEX 0, 0, 540, 320
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME |
      WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "BoardMaster"
MENU IDR_MAINMENU
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_TAB, WC_TABCONTROL, WS_TABSTOP, 6, 6, 528, 286
    LTEXT           "", IDC_STATUSTEXT, 8, 300, 524, 10
END

/////////////////////////////////////////////////////////////////////////////
// Settings page

IDD_SETTINGS DIALOGEX 0, 0, 516, 258
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    GROUPBOX        "Configuration file (JSON)", IDC_GRP_CFG, 4, 2, 508, 46
    LTEXT           "File:", -1, 10, 18, 22, 8
    EDITTEXT        IDC_CFG_PATH, 34, 16, 300, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_CFG_BROWSE, 340, 15, 42, 14
    PUSHBUTTON      "Load", IDC_CFG_LOAD, 386, 15, 32, 14
    PUSHBUTTON      "Save", IDC_CFG_SAVE, 422, 15, 32, 14
    PUSHBUTTON      "Use default", IDC_CFG_DEFAULT, 458, 15, 48, 14
    LTEXT           "", IDC_CFG_NOTE, 10, 34, 496, 8

    GROUPBOX        "Machine configuration directory - pin types and message layout", IDC_GRP_PROFILE, 4, 52, 508, 94
    LTEXT           "Config dir:", -1, 10, 68, 40, 8
    EDITTEXT        IDC_PROFILE_DIR, 52, 66, 336, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_PROFILE_BROWSE, 392, 65, 42, 14
    PUSHBUTTON      "Reload", IDC_PROFILE_RELOAD, 438, 65, 44, 14
    EDITTEXT        IDC_PROFILE_INFO, 10, 84, 496, 56,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | NOT WS_TABSTOP

    GROUPBOX        "Boards", IDC_GRP_BOARDS, 4, 150, 508, 104
    LTEXT           "Number of boards:", -1, 10, 166, 62, 8
    EDITTEXT        IDC_BOARDS_NUM, 74, 164, 26, 12, ES_NUMBER
    CONTROL         "", IDC_BOARDS_SPIN, UPDOWN_CLASS,
                    UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | WS_TABSTOP,
                    100, 164, 11, 12
    LTEXT           "(1 - 16)", -1, 116, 166, 30, 8
    PUSHBUTTON      "Connect All", IDC_CONNECT_ALL, 300, 163, 54, 14
    PUSHBUTTON      "Disconnect All", IDC_DISCONNECT_ALL, 358, 163, 60, 14
    PUSHBUTTON      "Identify", IDC_IDENTIFY, 422, 163, 44, 14
    CONTROL         "", IDC_BOARDS_LIST, WC_LISTVIEW,
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,
                    10, 182, 300, 66
    LTEXT           "Transport:", IDC_LBL_TRANSPORT, 318, 184, 40, 8
    COMBOBOX        IDC_TRANSPORT, 360, 182, 60, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "COM port:", IDC_LBL_PORT, 318, 200, 40, 8
    EDITTEXT        IDC_PORT, 360, 198, 60, 12, ES_AUTOHSCROLL
    LTEXT           "TCP host:", IDC_LBL_HOST, 318, 216, 40, 8
    EDITTEXT        IDC_HOST, 360, 214, 60, 12, ES_AUTOHSCROLL
    LTEXT           "TCP port:", IDC_LBL_TCPPORT, 318, 232, 40, 8
    EDITTEXT        IDC_TCPPORT, 360, 230, 60, 12, ES_NUMBER
    PUSHBUTTON      "Apply to board", IDC_BOARD_APPLY, 426, 230, 78, 14
END

/////////////////////////////////////////////////////////////////////////////
// I/O page

IDD_IO DIALOGEX 0, 0, 516, 258
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Board:", -1, 8, 8, 24, 8
    COMBOBOX        IDC_IO_BOARD, 34, 6, 96, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Enable writes (outputs armed)", IDC_IO_ARM, 140, 7, 130, 10
    LTEXT           "", IDC_IO_NOTE, 276, 8, 236, 8

    GROUPBOX        "AI  -  analog input  (read)", -1, 4, 22, 250, 100
    LTEXT           "Connector:", -1, 12, 40, 40, 8
    COMBOBOX        IDC_AI_CONN, 54, 38, 56, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pin:", -1, 116, 40, 16, 8
    COMBOBOX        IDC_AI_PIN, 134, 38, 48, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AI_REG, 12, 58, 234, 8
    PUSHBUTTON      "Read", IDC_AI_ACT, 12, 72, 44, 14
    LTEXT           "Value:", -1, 62, 75, 22, 8
    EDITTEXT        IDC_AI_VALUE, 86, 73, 52, 12, ES_READONLY | ES_RIGHT
    LTEXT           "", IDC_AI_EXTRA, 142, 75, 104, 8
    LTEXT           "", IDC_AI_STATUS, 12, 92, 234, 8

    GROUPBOX        "DI  -  digital input  (read)", -1, 262, 22, 250, 100
    LTEXT           "Connector:", -1, 270, 40, 40, 8
    COMBOBOX        IDC_DI_CONN, 312, 38, 56, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pin:", -1, 374, 40, 16, 8
    COMBOBOX        IDC_DI_PIN, 392, 38, 48, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_DI_REG, 270, 58, 234, 8
    PUSHBUTTON      "Read", IDC_DI_ACT, 270, 72, 44, 14
    LTEXT           "Value:", -1, 320, 75, 22, 8
    EDITTEXT        IDC_DI_VALUE, 344, 73, 52, 12, ES_READONLY | ES_RIGHT
    LTEXT           "", IDC_DI_EXTRA, 400, 75, 104, 8
    LTEXT           "", IDC_DI_STATUS, 270, 92, 234, 8

    GROUPBOX        "AO  -  analog output  (write)", -1, 4, 128, 250, 100
    LTEXT           "Connector:", -1, 12, 146, 40, 8
    COMBOBOX        IDC_AO_CONN, 54, 144, 56, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pin:", -1, 116, 146, 16, 8
    COMBOBOX        IDC_AO_PIN, 134, 144, 48, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_AO_REG, 12, 164, 234, 8
    LTEXT           "Value:", -1, 12, 181, 22, 8
    EDITTEXT        IDC_AO_VALUE, 36, 179, 52, 12, ES_NUMBER | ES_RIGHT
    LTEXT           "", IDC_AO_EXTRA, 92, 181, 92, 8
    PUSHBUTTON      "Write", IDC_AO_ACT, 190, 178, 56, 14
    LTEXT           "", IDC_AO_STATUS, 12, 198, 234, 8

    GROUPBOX        "DO  -  digital output  (write)", -1, 262, 128, 250, 100
    LTEXT           "Connector:", -1, 270, 146, 40, 8
    COMBOBOX        IDC_DO_CONN, 312, 144, 56, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Pin:", -1, 374, 146, 16, 8
    COMBOBOX        IDC_DO_PIN, 392, 144, 48, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_DO_REG, 270, 164, 234, 8
    LTEXT           "Value:", -1, 270, 181, 22, 8
    EDITTEXT        IDC_DO_VALUE, 294, 179, 52, 12, ES_NUMBER | ES_RIGHT
    LTEXT           "", IDC_DO_EXTRA, 350, 181, 92, 8
    PUSHBUTTON      "Write", IDC_DO_ACT, 448, 178, 56, 14
    LTEXT           "", IDC_DO_STATUS, 270, 198, 234, 8

    LTEXT           "", -1, 4, 234, 508, 8
END

/////////////////////////////////////////////////////////////////////////////
// Log page

IDD_LOG DIALOGEX 0, 0, 516, 258
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    EDITTEXT        IDC_LOG_TEXT, 4, 4, 508, 228,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL |
                    WS_VSCROLL | WS_HSCROLL | NOT WS_TABSTOP
    PUSHBUTTON      "Clear", IDC_LOG_CLEAR, 4, 238, 44, 14
    PUSHBUTTON      "Save...", IDC_LOG_SAVE, 52, 238, 44, 14
    LTEXT           "", IDC_LOG_INFO, 104, 241, 408, 8
END
